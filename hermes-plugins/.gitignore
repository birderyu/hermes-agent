# The repository's hermes-*/* rule otherwise hides renamed plugin sources.
!/.gitignore
!/README.md
!/conftest.py
!/ollo-inbox/
!/ollo-location/
!/ollo-conversation/
!/ollo-bridge/
!/ollo-bridge/**/
!/ollo-bridge/**/*.json
!/ollo-bridge/**/*.md
!/ollo-bridge/**/*.swift
!/ollo-bridge/**/*.plist
!/ollo-*/*.py
!/ollo-*/*.yaml
!/ollo-*/*.md

# Runtime data and credentials never belong in a plugin source checkout.
**/__pycache__/
**/*.sqlite*
**/*.db*
**/*.p8
**/*.key
**/.env
